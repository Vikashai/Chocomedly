# Chocomedley - Hostinger production environment template
# Copy this file to hostinger.env, fill in the real secrets, then import it in
# hPanel -> Websites -> chocomedley.com -> Node.js app -> Environment variables.
# hostinger.env is git-ignored. Never commit real secrets.

NODE_ENV=production

# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Admin bootstrap: keep true until the real admin is created at /setup-admin, then set false and restart.
ADMIN_SETUP_ENABLED=true
ADMIN_AUTH_DISABLED=false
DEMO_ADMIN_ENABLED=false
DEMO_ADMIN_ALLOW_ANY_LOGIN=false
DEMO_ADMIN_EMAIL=admin@chocomedley.in
DEMO_ADMIN_PASSWORD=

# Optional secure recovery login. Set both values, redeploy once, confirm login,
# then remove both variables and redeploy. The hashed admin remains in MySQL.
ADMIN_RECOVERY_EMAIL=
ADMIN_RECOVERY_PASSWORD=

# Production storage: MySQL only. Do not use json for the live site.
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=u810694964_user
DB_PASSWORD=REPLACE_WITH_HOSTINGER_DB_PASSWORD
DB_NAME=u810694964_prod
DB_CONNECTION_LIMIT=5

# Writable persistent paths outside the auto-deployed code folder.
# If the runtime log shows EACCES/ENOENT for these, switch to the domain folder:
#   DATA_DIR=/home/u810694964/domains/chocomedley.com/chocomedley-runtime
#   UPLOAD_DIR=/home/u810694964/domains/chocomedley.com/chocomedley-uploads
DATA_DIR=/home/u810694964/chocomedley-runtime
UPLOAD_DIR=/home/u810694964/chocomedley-uploads

# Optional: unlocks detailed diagnostics at /healthz?token=THIS_VALUE
HEALTH_TOKEN=REPLACE_WITH_RANDOM_DIAGNOSTIC_TOKEN

# Customer order-status emails. Use credentials from your email provider.
PUBLIC_WHATSAPP_NUMBER=7569907353
ORDER_EMAIL_ACCOUNT=chocomedley@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=chocomedley@gmail.com
SMTP_PASSWORD=PASTE_GMAIL_APP_PASSWORD_HERE
SMTP_FROM=Chocomedley <chocomedley@gmail.com>
SMTP_REPLY_TO=chocomedley@gmail.com
