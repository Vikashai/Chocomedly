PORT=3000
NODE_ENV=production
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_SETUP_ENABLED=true
DEMO_ADMIN_ENABLED=false
DEMO_ADMIN_EMAIL=admin@chocomedley.in
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_ALLOW_ANY_LOGIN=false
ADMIN_AUTH_DISABLED=false
ADMIN_RECOVERY_EMAIL=
ADMIN_RECOVERY_PASSWORD=
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_hostinger_database_user
DB_PASSWORD=your_hostinger_database_password
DB_NAME=your_hostinger_database_name
DB_CONNECTION_LIMIT=5
DATA_DIR=/home/your_hostinger_username/chocomedley-runtime
UPLOAD_DIR=/home/your_hostinger_username/chocomedley-uploads
HEALTH_TOKEN=optional-random-token-for-healthz-diagnostics

# Customer status emails. Gmail requires an App Password, not the normal Gmail password.
PUBLIC_WHATSAPP_NUMBER=7569907353
ORDER_EMAIL_ACCOUNT=chocomedleyteam@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=chocomedleyteam@gmail.com
SMTP_PASSWORD=PASTE_GMAIL_APP_PASSWORD_HERE
SMTP_FROM=Chocomedley <chocomedleyteam@gmail.com>
SMTP_REPLY_TO=chocomedleyteam@gmail.com
